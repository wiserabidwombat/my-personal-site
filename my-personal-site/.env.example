# Copy to .env.local (already gitignored) and fill in real values.
# These are also required as env vars in the Vercel dashboard for the
# matching api/*.ts function -- never commit real values here.
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_DATA_SOURCE_ID=

# Neon Postgres connection string (Vercel Marketplace -> Storage -> Neon
# auto-injects this as DATABASE_URL once the integration is added).
# Used by scripts/migrate.mjs locally and by api/fossils.ts in production.
DATABASE_URL=

# Hardcover (books page). Get a token at https://hardcover.app/account/api --
# it expires after 1 year and cannot be renewed programmatically, so you'll
# need to generate a new one and update it here/in Vercel when it does.
# HARDCOVER_USER_ID is your numeric Hardcover user id, not a secret -- get it
# by querying `{ me { id } }` against the API with your token.
HARDCOVER_API_TOKEN=
HARDCOVER_USER_ID=
