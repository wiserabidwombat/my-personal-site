# Copy to .env.local (already gitignored) and fill in real values.
# These are also required as env vars in the Vercel dashboard for the
# matching api/*.ts function -- never commit real values here.
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=

# BoardGameGeek XML API application token (registration required by BGG).
# Only used locally by scripts/sync-bgg.mjs -- not needed in Vercel.
BGG_API_TOKEN=

# Neon Postgres connection string (Vercel Marketplace -> Storage -> Neon
# auto-injects this as DATABASE_URL once the integration is added).
# Used by scripts/migrate.mjs locally and by api/fossils.ts in production.
DATABASE_URL=

# Hardcover (books page). Get a token at https://hardcover.app/account/api --
# it expires after 1 year and cannot be renewed programmatically, so you'll
# need to generate a new one and update it here/in Vercel when it does.
# HARDCOVER_USER_ID is your numeric Hardcover user id, not a secret -- get it
# by querying `{ me { id } }` against the API with your token.
HARDCOVER_API_TOKEN=
HARDCOVER_USER_ID=

# Spotify (music page). Create an app in the Spotify Developer Dashboard with
# the redirect URI http://127.0.0.1:8888/callback, add the client ID and
# secret here, then run `npm run spotify:auth` once and paste the refresh
# token it prints. All three are also needed in Vercel for api/spotify.ts.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
# Optional: "true" shows what's playing right now on the Music page (off by
# default; when on, the API response is cached for 30s instead of 60s).
SPOTIFY_SHOW_NOW_PLAYING=
# Optional: comma-separated Spotify playlist IDs to hide from the Music page
# (the ID is the part after /playlist/ in a playlist's share link).
SPOTIFY_EXCLUDED_PLAYLISTS=
