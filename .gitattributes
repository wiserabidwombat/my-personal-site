# Store and check out text files with LF line endings on every platform.
# Without this, Windows checkouts (core.autocrlf=true) get CRLF, and tools
# that write LF -- like the TanStack Router plugin regenerating
# src/routeTree.gen.ts on every dev start -- leave files showing as modified
# with no real change.
* text=auto eol=lf

# Binary assets: never touch their bytes.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# Generated by @tanstack/router-plugin; collapsed in GitHub diffs.
src/routeTree.gen.ts linguist-generated=true
